.DS_Store
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Orphaned atomic-write temp files from a killed run (fetch_wecom_docs.py
# also cleans these up on startup; this is a safety net in case a `git add`
# happens before the fetcher gets to run again).
docs/**/.*.tmp*

# scripts/debug_capture_raw_html.py output -- ad hoc audit copies, not part
# of the public mirror (that's the converted docs/wecom/*.md).
/raw_html/

# Internal working notes for picking up in-progress work across sessions --
# not part of the public mirror.
/HANDOFF.md
